# NotebookLM Knowledge Base Configuration
NOTEBOOK_ID=your_notebook_id_here

# Optional: Headless Master Token (for automatic cookie re-minting without browser logins)
# NOTEBOOKLM_MASTER_TOKEN="oauth_token_or_master_token"

# Fallback: Playwright / Cookie Export JSON or Cookie String
# NOTEBOOKLM_COOKIE="session=..."

# Obsidian Vault Configuration
OBSIDIAN_VAULT_ROOT=C:\dev\kb-sync\obsidian\vault

# Optional: Webhook URL for Automated Failure Notifications (Slack, Discord, Teams, or HTTP endpoint)
# WEBHOOK_URL="https://hooks.slack.com/services/..."

